<UserControl x:Class="TrafficLens.App.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding ConnectionsLabel}"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource TextMutedBrush}"
                   Margin="0,14,0,10" />

        <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="12,10" Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding ErrorTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorDetail}" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,8">
<Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding ShowLabel}" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding FilterOptions}"
                      SelectedValuePath="Key" DisplayMemberPath="Label"
                      SelectedValue="{Binding Filter}"
                      Background="{StaticResource SurfaceBrush}"
                      Foreground="{StaticResource TextBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      MinWidth="120" Margin="6,0,16,0" />

            <TextBlock Grid.Column="2" Text="{Binding AddressFamilyLabel}" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="3" ItemsSource="{Binding FamilyFilterOptions}"
                      SelectedValuePath="Key" DisplayMemberPath="Label"
                      SelectedValue="{Binding FamilyFilter}"
                      Background="{StaticResource SurfaceBrush}"
                      Foreground="{StaticResource TextBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      MinWidth="100" Margin="6,0,16,0" />

            <TextBlock Grid.Column="4" Text="{Binding SortByLabel}" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="5" ItemsSource="{Binding SortOptions}"
                      SelectedValuePath="Key" DisplayMemberPath="Label"
                      SelectedValue="{Binding SortKey}"
                      Background="{StaticResource SurfaceBrush}"
                      Foreground="{StaticResource TextBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      MinWidth="160" Margin="6,0,16,0" />
        </Grid>

        <CheckBox Grid.Row="3" Margin="0,8,0,0"
                  Content="{Binding HideListenersLabel}"
                  IsChecked="{Binding HideListeners}"
                  AutomationProperties.Name="ConnectionsHideListeners"
                  VerticalAlignment="Center" />

        <CheckBox Grid.Row="4" Margin="0,8,0,0"
                  Content="{Binding EnableReverseDnsLabel}"
                  IsChecked="{Binding EnableReverseDns}"
                  AutomationProperties.Name="ConnectionsEnableReverseDns"
                  VerticalAlignment="Center" />

        <Grid Grid.Row="6" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding SearchPlaceholder}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         MinWidth="200" Padding="6,4" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="6" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="14,12" Margin="0,0,0,0"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding NoActiveConnectionsText}"
                       Foreground="{StaticResource TextMutedBrush}" />
        </Border>

        <Grid Grid.Row="6"
              Visibility="{Binding IsNotEmpty, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,1,1,0" Padding="8,8,8,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1" Text="{Binding ProcessLabel}"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding PidLabel}"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding ProtocolLabel}"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Grid.Column="4" Text="{Binding StateLabel}"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Grid.Column="5" Text="{Binding LocalEndpointLabel}"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Grid.Column="6" Text="{Binding RemoteEndpointLabel}"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                <ItemsControl ItemsSource="{Binding Connections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel VirtualizationMode="Recycling" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" Padding="8,6,8,6" Margin="0,0,0,6"
                                    AutomationProperties.Name="{Binding Name}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding Path=DataContext.CopyLocalEndpointLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  Command="{Binding CopyLocalEndpointCommand}"
                                                  AutomationProperties.Name="CopyLocalEndpoint" />
                                        <MenuItem Header="{Binding Path=DataContext.CopyRemoteEndpointLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  Command="{Binding CopyRemoteEndpointCommand}"
                                                  AutomationProperties.Name="CopyRemoteEndpoint" />
                                        <MenuItem Header="{Binding Path=DataContext.CopyRemoteIpLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  Command="{Binding CopyRemoteIpCommand}"
                                                  AutomationProperties.Name="CopyRemoteIp" />
                                        <MenuItem Header="{Binding Path=DataContext.CopyProcessNameLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  Command="{Binding CopyProcessNameCommand}"
                                                  AutomationProperties.Name="CopyProcessName" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Source="{Binding Icon}"
                                           Width="16" Height="16" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="2" Text="{Binding PidText}" FlowDirection="LeftToRight"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="3" Text="{Binding ProtocolText}"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="4" Text="{Binding StateText}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" FlowDirection="LeftToRight"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="5" Text="{Binding LocalText}" FlowDirection="LeftToRight"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="6" Text="{Binding RemoteText}" FlowDirection="LeftToRight"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>