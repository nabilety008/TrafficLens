<UserControl x:Class="TrafficLens.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,14,20,8" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="{Binding SettingsTitle}"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,0,0,10" />

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding GeneralLabel}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{Binding LanguageLabel}"
                                   VerticalAlignment="Center" Margin="0,0,12,8" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  AutomationProperties.Name="SettingsLanguageCombo"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Background="{StaticResource SurfaceAltBrush}"
                                  Foreground="{StaticResource TextBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  HorizontalAlignment="Left" MinWidth="160"
                                  Margin="0,0,0,8" />

                        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                  AutomationProperties.Name="SettingsStartWithWindows"
                                  Content="{Binding StartWithWindowsLabel}"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                  Margin="0,0,0,6" />

                        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                  AutomationProperties.Name="SettingsStartMinimized"
                                  Content="{Binding StartMinimizedLabel}"
                                  IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                                  Margin="0,0,0,2" />

                        <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                AutomationProperties.Name="SettingsGetStarted"
                                Content="{Binding GetStartedLabel}"
                                Command="{Binding ShowGuideCommand}"
                                Background="{StaticResource SurfaceAltBrush}"
                                Foreground="{StaticResource TextBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                Padding="10,4" Margin="0,6,0,0"
                                HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding SystemTrayLabel}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,10" />

                    <CheckBox AutomationProperties.Name="SettingsMinimizeToTray"
                              Content="{Binding MinimizeToTrayLabel}"
                              IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                              Margin="0,0,0,6" />
                    <CheckBox AutomationProperties.Name="SettingsCloseToTray"
                              Content="{Binding CloseToTrayLabel}"
                              IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                              Margin="0,0,0,2" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding WidgetLabel}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,10" />

                    <CheckBox AutomationProperties.Name="SettingsWidgetEnabled"
                              Content="{Binding EnableFloatingWidgetLabel}"
                              IsChecked="{Binding WidgetEnabled, Mode=TwoWay}"
                              Margin="0,0,0,6" />
                    <CheckBox AutomationProperties.Name="SettingsWidgetAlwaysOnTop"
                              Content="{Binding AlwaysOnTopLabel}"
                              IsChecked="{Binding WidgetAlwaysOnTop, Mode=TwoWay}"
                              Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <Button AutomationProperties.Name="SettingsShowWidget"
                                Content="{Binding ShowWidgetLabel}"
                                Command="{Binding ShowWidgetCommand}"
                                Background="{StaticResource SurfaceAltBrush}"
                                Foreground="{StaticResource TextBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                Padding="10,4" Margin="0,0,6,0" />
                        <Button AutomationProperties.Name="SettingsHideWidget"
                                Content="{Binding HideWidgetLabel}"
                                Command="{Binding HideWidgetCommand}"
                                Background="{StaticResource SurfaceAltBrush}"
                                Foreground="{StaticResource TextBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                Padding="10,4" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding AlertsLabel}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding AlertRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="84" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              AutomationProperties.Name="{Binding Id, StringFormat='SettingsRule{0}Enabled'}"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBox Grid.Column="2"
                                             AutomationProperties.Name="{Binding Id, StringFormat='SettingsRule{0}Threshold'}"
                                             Text="{Binding ThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FlowDirection="LeftToRight"
                                             TextAlignment="Right"
                                             Background="{StaticResource SurfaceAltBrush}"
                                             Foreground="{StaticResource TextBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             Padding="6,4" Margin="0,0,8,0" />

                                    <ComboBox Grid.Column="3"
                                              AutomationProperties.Name="{Binding Id, StringFormat='SettingsRule{0}Unit'}"
                                              ItemsSource="{Binding UnitOptions}"
                                              SelectedIndex="{Binding UnitIndex, Mode=TwoWay}"
                                              Background="{StaticResource SurfaceAltBrush}"
                                              Foreground="{StaticResource TextBrush}"
                                              BorderBrush="{StaticResource BorderBrush}"
                                              Padding="6,4" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,4,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding CooldownLabel}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Column="1"
                                 AutomationProperties.Name="SettingsCooldown"
                                 Text="{Binding CooldownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Right"
                                 Width="64"
                                 Background="{StaticResource SurfaceAltBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 Padding="6,4" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding MinutesLabel}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding CooldownRangeLabel}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,8" />

                    <TextBlock Text="{Binding ValidationError}"
                               FontSize="11"
                               Foreground="#E57373"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding SavedNotice}"
                               FontSize="11"
                               Foreground="{StaticResource AccentAltBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="{Binding HasSavedNotice, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Orientation="Horizontal">
                        <Button AutomationProperties.Name="SettingsSave"
                                Content="{Binding SaveLabel}"
                                Command="{Binding SaveCommand}"
                                FontWeight="SemiBold"
                                Background="{StaticResource AccentBrush}"
                                Foreground="#101018"
                                BorderBrush="{StaticResource AccentBrush}"
                                Padding="22,6" Margin="0,0,8,0" />
                        <Button AutomationProperties.Name="SettingsReset"
                                Content="{Binding ResetToDefaultsLabel}"
                                Command="{Binding ResetCommand}"
                                Background="{StaticResource SurfaceAltBrush}"
                                Foreground="{StaticResource TextBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                Padding="14,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>