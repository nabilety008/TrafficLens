<UserControl x:Class="TrafficLens.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,14,20,8" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="{Binding AboutTitleLabel}"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,0,0,10" />

            <Button AutomationProperties.Name="AboutGetStarted"
                    Content="{Binding GetStartedLabel}"
                    Command="{Binding ShowGuideCommand}"
                    Background="{StaticResource SurfaceAltBrush}"
                    Foreground="{StaticResource TextBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    Padding="10,4"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,10" />

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="pack://application:,,,/TrafficLens.ico"
                               Width="48" Height="48" Margin="0,0,14,0"
                               VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock AutomationProperties.Name="AboutProductName"
                                       Text="{Binding ProductNameText}"
                                       FontSize="24" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0" FlowDirection="LeftToRight">
                                <TextBlock Text="{Binding VersionLabel}"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding VersionText}"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding AboutDescriptionLabel}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{Binding RuntimeLabel}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,8" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding RuntimeText}"
                               FontSize="12" Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{Binding OsLabel}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,8" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding OsText}"
                               FontSize="12" Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="{Binding CultureLabel}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,8" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding CultureText}"
                               FontSize="12" Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="{Binding VersionLabel}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Text="{Binding VersionText}"
                               FontSize="12" Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="{Binding DiagnosticsHeaderLabel}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{Binding DataPathLabel}"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,8" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   AutomationProperties.Name="AboutDataPath"
                                   Text="{Binding DataPathText}"
                                   FontSize="12" Foreground="{StaticResource TextBrush}"
                                   FlowDirection="LeftToRight" TextAlignment="Left"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{Binding SettingsPathLabel}"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,8" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   AutomationProperties.Name="AboutSettingsPath"
                                   Text="{Binding SettingsPathText}"
                                   FontSize="12" Foreground="{StaticResource TextBrush}"
                                   FlowDirection="LeftToRight" TextAlignment="Left"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{Binding LogsPathLabel}"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   AutomationProperties.Name="AboutLogsPath"
                                   Text="{Binding LogsPathText}"
                                   FontSize="12" Foreground="{StaticResource TextBrush}"
                                   FlowDirection="LeftToRight" TextAlignment="Left"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button AutomationProperties.Name="AboutCopyDiagnostics"
                                Content="{Binding CopyDiagnosticsLabel}"
                                Command="{Binding CopyDiagnosticsCommand}"
                                Background="{StaticResource SurfaceAltBrush}"
                                Foreground="{StaticResource TextBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                Padding="10,4" Margin="0,0,8,0" />
                        <Button AutomationProperties.Name="AboutOpenLogs"
                                Content="{Binding OpenLogFolderLabel}"
                                Command="{Binding OpenLogsCommand}"
                                Background="{StaticResource SurfaceAltBrush}"
                                Foreground="{StaticResource TextBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                Padding="10,4" />
                    </StackPanel>

                    <TextBlock Text="{Binding DiagnosticsCopiedLabel}"
                               FontSize="11" Foreground="{StaticResource AccentAltBrush}"
                               Visibility="{Binding HasCopiedNotice, Converter={StaticResource BoolToVis}}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>