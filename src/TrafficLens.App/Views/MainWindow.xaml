<Window x:Class="TrafficLens.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrafficLens.App.ViewModels"
        xmlns:views="clr-namespace:TrafficLens.App.Views"
        xmlns:controls="clr-namespace:TrafficLens.App.Controls"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="900" Height="560"
        WindowStartupLocation="CenterScreen"
        MinWidth="640" MinHeight="420">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding WindowTitle}"
                           FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding FloatingWidgetToggleLabel}"
                            Command="{Binding ToggleFloatingWidgetCommand}"
                            Background="{StaticResource SurfaceAltBrush}"
                            Foreground="{StaticResource TextBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            Margin="3,0" Padding="10,4" />
                    <Button Content="English"
                            Command="{Binding SwitchToEnglishCommand}"
                            Background="{StaticResource SurfaceAltBrush}"
                            Foreground="{StaticResource TextBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            Margin="3,0" Padding="10,4" />
                    <Button Content="فارسی"
                            Command="{Binding SwitchToPersianCommand}"
                            Background="{StaticResource SurfaceAltBrush}"
                            Foreground="{StaticResource TextBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            Margin="3,0" Padding="10,4" />
                    <ToggleButton x:Name="OptionsToggleButton"
                                  Content="&#8943;"
                                  Background="{StaticResource SurfaceAltBrush}"
                                  Foreground="{StaticResource TextBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  Margin="3,0" Padding="10,4" />
                    <Popup PlacementTarget="{Binding ElementName=OptionsToggleButton}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           IsOpen="{Binding IsChecked, ElementName=OptionsToggleButton, Mode=TwoWay}">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" Padding="12,8">
                            <StackPanel>
                                <CheckBox Content="{Binding MinimizeToTrayLabel}"
                                          IsChecked="{Binding MinimizeToTray}"
                                          Margin="0,2" />
                                <CheckBox Content="{Binding CloseToTrayLabel}"
                                          IsChecked="{Binding CloseToTray}"
                                          Margin="0,2" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="{Binding DashboardNavLabel}"
                        Command="{Binding ShowDashboardCommand}"
                        Background="{StaticResource SurfaceBrush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Padding="14,6" Margin="0,0,8,0" />
                <Button Content="{Binding ApplicationsNavLabel}"
                        Command="{Binding ShowApplicationsCommand}"
                        Background="{StaticResource SurfaceBrush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Padding="14,6" Margin="0,0,8,0" />
                <Button Content="{Binding ConnectionsNavLabel}"
                        Command="{Binding ShowConnectionsCommand}"
                        Background="{StaticResource SurfaceBrush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Padding="14,6" Margin="0,0,8,0" />
                <Button Content="{Binding HistoryNavLabel}"
                        Command="{Binding ShowHistoryCommand}"
                        Background="{StaticResource SurfaceBrush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Padding="14,6" Margin="0,0,8,0" />
                <Button Content="{Binding AlertsNavLabel}"
                        Command="{Binding ShowAlertsCommand}"
                        Background="{StaticResource SurfaceBrush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Padding="14,6" Margin="0,0,8,0" />
                <Button AutomationProperties.Name="NavSettings"
                        Content="{Binding SettingsNavLabel}"
                        Command="{Binding ShowSettingsCommand}"
                        Background="{StaticResource SurfaceBrush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Padding="14,6" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="20,14,20,8">

                <TextBlock Text="{Binding Dashboard.DashboardLabel}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,0,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,6,0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Padding="16,14">
                        <StackPanel FlowDirection="LeftToRight">
                            <TextBlock Text="{Binding Dashboard.DownloadLabel}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Dashboard.DownloadText}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,2"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Dashboard.DownloadMbpsText}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="6,0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Padding="16,14">
                        <StackPanel FlowDirection="LeftToRight">
                            <TextBlock Text="{Binding Dashboard.UploadLabel}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Dashboard.UploadText}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentAltBrush}" Margin="0,0,0,2"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Dashboard.UploadMbpsText}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Margin="6,0,0,0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Padding="16,14">
                        <StackPanel FlowDirection="LeftToRight">
                            <TextBlock Text="{Binding Dashboard.TotalLabel}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Dashboard.TotalText}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Dashboard.TotalMbpsText}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="{Binding Dashboard.ActiveAdapterLabel}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,18,0,8" />

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Padding="14,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Dashboard.ActiveAdapterName}"
                                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Dashboard.ActiveAdapterKindText}"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Dashboard.ActiveAdapterStatusText}"
                                   FontSize="12" Foreground="{StaticResource AccentAltBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Dashboard.GraphLiveTrafficLabel}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,18,0,8" />

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="{Binding Dashboard.GraphLast30SecondsLabel}"
                                    Command="{Binding Dashboard.SelectGraphRangeCommand}"
                                    CommandParameter="30"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    Foreground="{StaticResource TextBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    Padding="10,4" Margin="0,0,6,0" />
                            <Button Content="{Binding Dashboard.GraphLast1MinuteLabel}"
                                    Command="{Binding Dashboard.SelectGraphRangeCommand}"
                                    CommandParameter="60"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    Foreground="{StaticResource TextBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    Padding="10,4" Margin="6,0" />
                            <Button Content="{Binding Dashboard.GraphLast5MinutesLabel}"
                                    Command="{Binding Dashboard.SelectGraphRangeCommand}"
                                    CommandParameter="300"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    Foreground="{StaticResource TextBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    Padding="10,4" Margin="6,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                            <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"
                                    Background="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding Dashboard.GraphDownloadSeriesLabel}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,0"
                                       VerticalAlignment="Center" />
                            <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"
                                    Background="{StaticResource AccentAltBrush}" />
                            <TextBlock Text="{Binding Dashboard.GraphUploadSeriesLabel}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <controls:TrafficGraphControl Height="190"
                                                      Points="{Binding Dashboard.GraphPoints}"
                                                      YAxisMax="{Binding Dashboard.GraphScaleMax}"
                                                      WindowSeconds="{Binding Dashboard.GraphWindowSeconds}"
                                                      ReferenceTime="{Binding Dashboard.GraphReferenceTime}"
                                                      NowLabel="{Binding Dashboard.GraphNowLabel}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Dashboard.NetworkAdaptersLabel}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,18,0,8" />

                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Dashboard.Adapters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" Padding="12,10" Margin="0,0,0,8"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding KindText}" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="•" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="6,0" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" FlowDirection="LeftToRight"
                                                    VerticalAlignment="Center" Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="↓" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="{Binding DownloadRateText}" FontSize="12"
                                                           Margin="4,0,0,0" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="↑" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentAltBrush}" />
                                                <TextBlock Text="{Binding UploadRateText}" FontSize="12"
                                                           Margin="4,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </ScrollViewer>

        <ContentControl x:Name="ApplicationsHost" Grid.Row="2"
                                 Visibility="{Binding IsApplicationsVisible, Converter={StaticResource BoolToVis}}" />

        <ContentControl x:Name="ConnectionsHost" Grid.Row="2"
                                 Visibility="{Binding IsConnectionsVisible, Converter={StaticResource BoolToVis}}" />

        <ContentControl x:Name="HistoryHost" Grid.Row="2"
                                 Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVis}}" />

        <ContentControl x:Name="AlertsHost" Grid.Row="2"
                                 Visibility="{Binding IsAlertsVisible, Converter={StaticResource BoolToVis}}" />

        <ContentControl x:Name="SettingsHost" Grid.Row="2"
                                 Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}" />

        <StatusBar Grid.Row="3" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextMutedBrush}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" />
        </StatusBar>
    </Grid>
</Window>