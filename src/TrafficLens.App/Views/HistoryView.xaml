<UserControl x:Class="TrafficLens.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:TrafficLens.App.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,14,20,8">
            <TextBlock Text="{Binding HistoryLabel}"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,0,0,10" />

            <Border Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="12,10" Margin="0,0,0,12"
                    Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding UnavailableText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorDetail}" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="{Binding TodayLabel}"
                        Command="{Binding SelectRangeCommand}" CommandParameter="0"
                        Background="{StaticResource SurfaceAltBrush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Padding="10,4" Margin="0,0,6,0" />
                <Button Content="{Binding YesterdayLabel}"
                        Command="{Binding SelectRangeCommand}" CommandParameter="1"
                        Background="{StaticResource SurfaceAltBrush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Padding="10,4" Margin="6,0" />
                <Button Content="{Binding Last7DaysLabel}"
                        Command="{Binding SelectRangeCommand}" CommandParameter="2"
                        Background="{StaticResource SurfaceAltBrush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Padding="10,4" Margin="6,0" />
                <Button Content="{Binding Last30DaysLabel}"
                        Command="{Binding SelectRangeCommand}" CommandParameter="3"
                        Background="{StaticResource SurfaceAltBrush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Padding="10,4" Margin="6,0" />
                <Button Content="{Binding LifetimeLabel}"
                        Command="{Binding SelectRangeCommand}" CommandParameter="4"
                        Background="{StaticResource SurfaceAltBrush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Padding="10,4" Margin="6,0" />
                <Button Content="{Binding ThisMonthLabel}"
                        Command="{Binding SelectRangeCommand}" CommandParameter="5"
                        Background="{StaticResource SurfaceAltBrush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Padding="10,4" Margin="6,0" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,6,0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Padding="16,14">
                    <StackPanel FlowDirection="LeftToRight">
                        <TextBlock Text="{Binding DownloadLabel}" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SummaryDownloadText}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="6,0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Padding="16,14">
                    <StackPanel FlowDirection="LeftToRight">
                        <TextBlock Text="{Binding UploadLabel}" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SummaryUploadText}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentAltBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Margin="6,0,0,0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Padding="16,14">
                    <StackPanel FlowDirection="LeftToRight">
                        <TextBlock Text="{Binding TotalLabel}" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SummaryTotalText}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{Binding ChartTitleLabel}"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,18,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"
                        Background="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding DownloadLabel}"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,0"
                           VerticalAlignment="Center" />
                <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"
                        Background="{StaticResource AccentAltBrush}" />
                <TextBlock Text="{Binding UploadLabel}"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="14,12">
                <Grid>
                    <controls:HistoryBarChartControl Height="220"
                                                     Points="{Binding Series}"
                                                     YAxisMax="{Binding ScaleMax}" />
                    <TextBlock Text="{Binding NoDataText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="14,12" Margin="0,12,0,0"
                    Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding TodayVsYesterdayLabel}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" FlowDirection="LeftToRight">
                            <TextBlock Text="{Binding TodayLabel}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding ComparisonTodayText}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" FlowDirection="LeftToRight" Margin="12,0">
                            <TextBlock Text="{Binding YesterdayAtThisTimeLabel}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding ComparisonYesterdayText}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" FlowDirection="LeftToRight">
                            <TextBlock Text="{Binding DifferenceLabel}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding ComparisonDifferenceText}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding ComparisonPercentageText}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Button Content="{Binding ExportCsvLabel}"
                    Command="{Binding ExportCsvCommand}"
                    Background="{StaticResource SurfaceAltBrush}"
                    Foreground="{StaticResource TextBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    Padding="14,6" Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="{Binding ExportCsvLabel}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
