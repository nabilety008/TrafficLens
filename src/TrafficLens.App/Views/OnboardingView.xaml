<UserControl x:Class="TrafficLens.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
             Focusable="False">
    <Grid>
        <Border x:Name="Backdrop"
                AutomationProperties.Name="OnboardingBackdrop"
                Background="#E0000000"
                IsHitTestVisible="True"
                Focusable="False" />

        <Border AutomationProperties.Name="OnboardingPanel"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Width="560" MaxHeight="520"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="20,16">
                <TextBlock AutomationProperties.Name="OnboardingTitle"
                           Text="{Binding GetStartedTitleLabel}"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8" />

                <TextBlock Text="{Binding GetStartedIntroLabel}"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,12" />

                <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto"
                              AutomationProperties.Name="OnboardingTopics">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding ApplicationsTopicLabel}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,2" />
                            <TextBlock Text="{Binding ApplicationsTopicText}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding TunnelsTopicLabel}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,2" />
                            <TextBlock Text="{Binding TunnelsTopicText}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding TrayTopicLabel}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,2" />
                            <TextBlock Text="{Binding TrayTopicText}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding WidgetTopicLabel}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,2" />
                            <TextBlock Text="{Binding WidgetTopicText}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding AlertsTopicLabel}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,2" />
                            <TextBlock Text="{Binding AlertsTopicText}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="{Binding LanguageTopicLabel}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,2" />
                            <TextBlock Text="{Binding LanguageTopicText}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Button x:Name="DismissButton"
                        AutomationProperties.Name="OnboardingDismiss"
                        Content="{Binding DismissLabel}"
                        Command="{Binding DismissCommand}"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0"
                        Padding="22,6"
                        Background="{StaticResource AccentBrush}"
                        Foreground="#101018"
                        BorderBrush="{StaticResource AccentBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>