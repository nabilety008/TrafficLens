<Page
    x:Class="TrafficLens.WinUI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrafficLens.WinUI.Controls"
    xmlns:models="using:TrafficLens.WinUI.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <Grid
            x:Name="RootLayout"
            Padding="24,20,24,24"
            ColumnSpacing="12"
            RowSpacing="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock
                    x:Name="PageTitleText"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Dashboard" />
                <TextBlock
                    x:Name="TunnelHintText"
                    Opacity="0.7"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <Grid
                x:Name="SummaryGrid"
                Grid.Row="1"
                ColumnSpacing="12"
                RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="DownloadCard"
                    Grid.Column="0"
                    Grid.Row="0"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="DownloadLabel"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Download" />
                        <TextBlock
                            x:Name="DownloadValueText"
                            FontSize="26"
                            FontWeight="SemiBold"
                            FlowDirection="LeftToRight"
                            Text="0 B/s" />
                        <TextBlock
                            x:Name="DownloadMbpsText"
                            FontSize="12"
                            FlowDirection="LeftToRight"
                            Opacity="0.65"
                            Text="0 Mbps" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="UploadCard"
                    Grid.Column="1"
                    Grid.Row="0"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="UploadLabel"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Upload" />
                        <TextBlock
                            x:Name="UploadValueText"
                            FontSize="26"
                            FontWeight="SemiBold"
                            FlowDirection="LeftToRight"
                            Text="0 B/s" />
                        <TextBlock
                            x:Name="UploadMbpsText"
                            FontSize="12"
                            FlowDirection="LeftToRight"
                            Opacity="0.65"
                            Text="0 Mbps" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="TotalCard"
                    Grid.Column="2"
                    Grid.Row="0"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="TotalLabel"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Total" />
                        <TextBlock
                            x:Name="TotalValueText"
                            FontSize="26"
                            FontWeight="SemiBold"
                            FlowDirection="LeftToRight"
                            Text="0 B/s" />
                        <TextBlock
                            x:Name="TotalMbpsText"
                            FontSize="12"
                            FlowDirection="LeftToRight"
                            Opacity="0.65"
                            Text="0 Mbps" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid
                x:Name="InsightGrid"
                Grid.Row="2"
                ColumnSpacing="12"
                RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="TodayCard"
                    Grid.Column="0"
                    Grid.Row="0"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock
                            x:Name="TodayHeader"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Today at a Glance" />
                        <Grid ColumnSpacing="12" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" Opacity="0.7" x:Name="DownloadTodayLabel" Text="Download" />
                            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="13" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Right" x:Name="TodayDownloadValue" Text="0 B" />

                            <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12" Opacity="0.7" x:Name="UploadTodayLabel" Text="Upload" />
                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="13" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Right" x:Name="TodayUploadValue" Text="0 B" />

                            <TextBlock Grid.Row="2" Grid.Column="0" FontSize="12" Opacity="0.7" x:Name="TotalTodayLabel" Text="Total" />
                            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="13" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Right" x:Name="TodayTotalValue" Text="0 B" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="TopAppCard"
                    Grid.Column="1"
                    Grid.Row="0"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="TopAppHeader"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Top App Now" />
                        <TextBlock
                            x:Name="TopAppStatusText"
                            FontSize="13"
                            Opacity="0.75"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <StackPanel x:Name="TopAppValuesPanel" Spacing="4">
                            <TextBlock
                                x:Name="TopAppNameText"
                                FontSize="16"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="TopAppRateText"
                                FontSize="13"
                                FlowDirection="LeftToRight"
                                Opacity="0.85"
                                Text="0 B/s" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock x:Name="TopAppDownloadLabel" FontSize="11" Opacity="0.65" Text="Download" />
                                    <TextBlock x:Name="TopAppDownloadValue" FontSize="12" FlowDirection="LeftToRight" Text="0 B/s" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Name="TopAppUploadLabel" FontSize="11" Opacity="0.65" Text="Upload" />
                                    <TextBlock x:Name="TopAppUploadValue" FontSize="12" FlowDirection="LeftToRight" Text="0 B/s" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="AdapterCard"
                    Grid.Column="2"
                    Grid.Row="0"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="ActiveAdapterHeader"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Active Adapter" />
                        <TextBlock
                            x:Name="AdapterNameText"
                            FontSize="16"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="AdapterKindLabel" FontSize="12" Opacity="0.65" Text="Kind" />
                                <TextBlock x:Name="AdapterKindText" FontSize="12" Text="" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="StatusLabel" FontSize="12" Opacity="0.65" Text="Status" />
                                <TextBlock x:Name="AdapterStatusText" FontSize="12" Text="" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Grid.Row="3"
                Padding="16,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="GraphHeader"
                        Grid.Row="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Live Traffic" />

                    <StackPanel Grid.Row="1" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton
                                x:Name="Range30sButton"
                                Content="Last 30 seconds"
                                GroupName="GraphRange"
                                IsChecked="{x:Bind ViewModel.Is30SecondsSelected, Mode=OneWay}"
                                Click="Range30s_Click" />
                            <RadioButton
                                x:Name="Range1mButton"
                                Content="Last 1 minute"
                                GroupName="GraphRange"
                                IsChecked="{x:Bind ViewModel.Is1MinuteSelected, Mode=OneWay}"
                                Click="Range1m_Click" />
                            <RadioButton
                                x:Name="Range5mButton"
                                Content="Last 5 minutes"
                                GroupName="GraphRange"
                                IsChecked="{x:Bind ViewModel.Is5MinutesSelected, Mode=OneWay}"
                                Click="Range5m_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="4" CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="DownloadSeriesLabel" FontSize="12" Opacity="0.75" Text="Download" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="4" CornerRadius="2" Background="{ThemeResource SuccessFillColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="UploadSeriesLabel" FontSize="12" Opacity="0.75" Text="Upload" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border
                        Grid.Row="2"
                        MinHeight="200"
                        Padding="0"
                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <controls:TrafficGraphView
                            x:Name="TrafficGraph"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                    </Border>

                    <TextBlock
                        Grid.Row="3"
                        FontSize="11"
                        HorizontalAlignment="Right"
                        Opacity="0.6"
                        Text="Now"
                        x:Name="GraphNowText" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
