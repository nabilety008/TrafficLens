<Page
    x:Class="TrafficLens.WinUI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrafficLens.WinUI.Controls"
    xmlns:models="using:TrafficLens.WinUI.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <StackPanel
            x:Name="RootLayout"
            Margin="20,14,20,12"
            Spacing="0">

            <TextBlock
                x:Name="PageTitleText"
                Margin="0,0,0,10"
                FontSize="12"
                FontWeight="SemiBold"
                Opacity="0.6"
                Text="Dashboard" />

            <Grid x:Name="SummaryGrid" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="DownloadCard"
                    Grid.Column="0"
                    Grid.Row="0"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="DownloadLabel"
                            Margin="0,0,0,6"
                            FontSize="12"
                            Opacity="0.6"
                            Text="Download" />
                        <TextBlock
                            x:Name="DownloadValueText"
                            Margin="0,0,0,2"
                            FontSize="26"
                            FontWeight="SemiBold"
                            FlowDirection="LeftToRight"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Text="0 B/s" />
                        <TextBlock
                            x:Name="DownloadMbpsText"
                            FontSize="12"
                            FlowDirection="LeftToRight"
                            Opacity="0.6"
                            Text="0 Mbps" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="UploadCard"
                    Grid.Column="1"
                    Grid.Row="0"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="UploadLabel"
                            Margin="0,0,0,6"
                            FontSize="12"
                            Opacity="0.6"
                            Text="Upload" />
                        <TextBlock
                            x:Name="UploadValueText"
                            Margin="0,0,0,2"
                            FontSize="26"
                            FontWeight="SemiBold"
                            FlowDirection="LeftToRight"
                            Foreground="{ThemeResource SuccessFillColorDefaultBrush}"
                            Text="0 B/s" />
                        <TextBlock
                            x:Name="UploadMbpsText"
                            FontSize="12"
                            FlowDirection="LeftToRight"
                            Opacity="0.6"
                            Text="0 Mbps" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="TotalCard"
                    Grid.Column="2"
                    Grid.Row="0"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="TotalLabel"
                            Margin="0,0,0,6"
                            FontSize="12"
                            Opacity="0.6"
                            Text="Total" />
                        <TextBlock
                            x:Name="TotalValueText"
                            Margin="0,0,0,2"
                            FontSize="26"
                            FontWeight="SemiBold"
                            FlowDirection="LeftToRight"
                            Text="0 B/s" />
                        <TextBlock
                            x:Name="TotalMbpsText"
                            FontSize="12"
                            FlowDirection="LeftToRight"
                            Opacity="0.6"
                            Text="0 Mbps" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock
                x:Name="TunnelHintText"
                Margin="6,4,0,0"
                FontSize="11"
                Opacity="0.6"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="TodayHeader"
                Margin="0,18,0,8"
                FontSize="12"
                FontWeight="SemiBold"
                Opacity="0.6"
                Text="Today at a Glance" />

            <Grid x:Name="TodayGrid" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="DownloadTodayCard"
                    Grid.Column="0"
                    Grid.Row="0"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="DownloadTodayLabel"
                            Margin="0,0,0,6"
                            FontSize="12"
                            Opacity="0.6"
                            Text="Download" />
                        <TextBlock
                            x:Name="TodayDownloadValue"
                            FontSize="22"
                            FontWeight="SemiBold"
                            FlowDirection="LeftToRight"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Text="0 B" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="UploadTodayCard"
                    Grid.Column="1"
                    Grid.Row="0"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="UploadTodayLabel"
                            Margin="0,0,0,6"
                            FontSize="12"
                            Opacity="0.6"
                            Text="Upload" />
                        <TextBlock
                            x:Name="TodayUploadValue"
                            FontSize="22"
                            FontWeight="SemiBold"
                            FlowDirection="LeftToRight"
                            Foreground="{ThemeResource SuccessFillColorDefaultBrush}"
                            Text="0 B" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="TotalTodayCard"
                    Grid.Column="2"
                    Grid.Row="0"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="TotalTodayLabel"
                            Margin="0,0,0,6"
                            FontSize="12"
                            Opacity="0.6"
                            Text="Total" />
                        <TextBlock
                            x:Name="TodayTotalValue"
                            FontSize="22"
                            FontWeight="SemiBold"
                            FlowDirection="LeftToRight"
                            Text="0 B" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock
                x:Name="TopAppHeader"
                Margin="0,18,0,8"
                FontSize="12"
                FontWeight="SemiBold"
                Opacity="0.6"
                Text="Top App Now" />

            <Border
                x:Name="TopAppCard"
                Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        x:Name="TopAppStatusText"
                        FontSize="12"
                        Opacity="0.6"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <StackPanel x:Name="TopAppValuesPanel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                x:Name="TopAppApplicationLabel"
                                Margin="0,0,8,0"
                                FontSize="12"
                                Opacity="0.6"
                                Text="Application" />
                            <TextBlock
                                x:Name="TopAppNameText"
                                FontSize="14"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel
                            Margin="0,6,0,0"
                            Orientation="Horizontal"
                            FlowDirection="LeftToRight">
                            <TextBlock
                                x:Name="TopAppCurrentLabel"
                                Margin="0,0,8,0"
                                FontSize="12"
                                Opacity="0.6"
                                Text="Current" />
                            <TextBlock
                                x:Name="TopAppRateText"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="0 B/s" />
                        </StackPanel>

                        <StackPanel
                            Margin="0,4,0,0"
                            Orientation="Horizontal"
                            FlowDirection="LeftToRight">
                            <TextBlock
                                x:Name="TopAppDownloadLabel"
                                Margin="0,0,4,0"
                                FontSize="11"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Text="Download" />
                            <TextBlock
                                x:Name="TopAppDownloadValue"
                                Margin="0,0,12,0"
                                FontSize="11"
                                Opacity="0.6"
                                Text="0 B/s" />
                            <TextBlock
                                x:Name="TopAppUploadLabel"
                                Margin="0,0,4,0"
                                FontSize="11"
                                Foreground="{ThemeResource SuccessFillColorDefaultBrush}"
                                Text="Upload" />
                            <TextBlock
                                x:Name="TopAppUploadValue"
                                FontSize="11"
                                Opacity="0.6"
                                Text="0 B/s" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock
                x:Name="ActiveAdapterHeader"
                Margin="0,18,0,8"
                FontSize="12"
                FontWeight="SemiBold"
                Opacity="0.6"
                Text="Active Adapter" />

            <Border
                x:Name="AdapterCard"
                Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        x:Name="AdapterNameText"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Margin="10,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="AdapterKindLabel"
                            FontSize="12"
                            Opacity="0.6"
                            Text="Kind" />
                        <TextBlock
                            x:Name="AdapterKindText"
                            Margin="6,0,0,0"
                            FontSize="12"
                            Opacity="0.6"
                            Text="" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="StatusLabel"
                            FontSize="12"
                            Opacity="0.6"
                            Text="Status" />
                        <TextBlock
                            x:Name="AdapterStatusText"
                            Margin="6,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource SuccessFillColorDefaultBrush}"
                            Text="" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock
                x:Name="GraphHeader"
                Margin="0,18,0,8"
                FontSize="12"
                FontWeight="SemiBold"
                Opacity="0.6"
                Text="Live Traffic" />

            <Border
                Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="0">
                    <StackPanel
                        Margin="0,0,0,8"
                        Orientation="Horizontal"
                        Spacing="6">
                        <RadioButton
                            x:Name="Range30sButton"
                            Content="Last 30 seconds"
                            GroupName="GraphRange"
                            IsChecked="{x:Bind ViewModel.Is30SecondsSelected, Mode=OneWay}"
                            Click="Range30s_Click" />
                        <RadioButton
                            x:Name="Range1mButton"
                            Content="Last 1 minute"
                            GroupName="GraphRange"
                            IsChecked="{x:Bind ViewModel.Is1MinuteSelected, Mode=OneWay}"
                            Click="Range1m_Click" />
                        <RadioButton
                            x:Name="Range5mButton"
                            Content="Last 5 minutes"
                            GroupName="GraphRange"
                            IsChecked="{x:Bind ViewModel.Is5MinutesSelected, Mode=OneWay}"
                            Click="Range5m_Click" />
                    </StackPanel>

                    <StackPanel
                        Margin="0,0,0,8"
                        Orientation="Horizontal"
                        Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border
                                Width="10"
                                Height="10"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock
                                x:Name="DownloadSeriesLabel"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.6"
                                Text="Download" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border
                                Width="10"
                                Height="10"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SuccessFillColorDefaultBrush}" />
                            <TextBlock
                                x:Name="UploadSeriesLabel"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.6"
                                Text="Upload" />
                        </StackPanel>
                    </StackPanel>

                    <Border
                        x:Name="GraphPlotBorder"
                        Height="190"
                        Padding="0"
                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <controls:TrafficGraphView
                            x:Name="TrafficGraph"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                    </Border>

                    <TextBlock
                        x:Name="GraphNowText"
                        Margin="0,4,0,0"
                        FontSize="11"
                        HorizontalAlignment="Right"
                        Opacity="0.5"
                        Text="Now" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
