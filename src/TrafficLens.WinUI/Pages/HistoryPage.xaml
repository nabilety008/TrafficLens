<Page
    x:Class="TrafficLens.WinUI.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrafficLens.WinUI.Controls"
    xmlns:infra="using:TrafficLens.WinUI.Infrastructure"
    xmlns:viewModels="using:TrafficLens.WinUI.ViewModels">

    <Page.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid x:Name="HistoryRoot">
        <ScrollViewer
            x:Name="PageScroller"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="RootLayout"
                Margin="16,12,16,12"
                Spacing="0">

                <TextBlock
                    x:Name="PageTitleText"
                    Margin="0,0,0,8"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Opacity="0.6"
                    Text="{x:Bind ViewModel.HistoryLabel, Mode=OneWay}" />

                <Border
                    x:Name="ErrorBanner"
                    Margin="0,0,0,10"
                    Padding="12,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="ErrorTitleText"
                            FontSize="12"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            Text="{x:Bind ViewModel.UnavailableText, Mode=OneWay}" />
                        <TextBlock
                            x:Name="ErrorDetailText"
                            FontSize="11"
                            Opacity="0.6"
                            TextWrapping="Wrap"
                            Text="{x:Bind ViewModel.ErrorDetail, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <TextBlock
                    x:Name="TodaySectionHeader"
                    Margin="0,0,0,6"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Opacity="0.6"
                    Text="{x:Bind ViewModel.TodayLabel, Mode=OneWay}" />

                <Grid x:Name="TodaySummaryGrid" Margin="0,0,0,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="TodayDownloadCard"
                        Grid.Column="0"
                        Padding="14,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="12"
                                Opacity="0.6"
                                Text="{x:Bind ViewModel.DownloadLabel, Mode=OneWay}" />
                            <TextBlock
                                FontSize="24"
                                FontWeight="SemiBold"
                                FlowDirection="LeftToRight"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Text="{x:Bind ViewModel.TodayDownloadText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="TodayUploadCard"
                        Grid.Column="1"
                        Padding="14,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="12"
                                Opacity="0.6"
                                Text="{x:Bind ViewModel.UploadLabel, Mode=OneWay}" />
                            <TextBlock
                                FontSize="24"
                                FontWeight="SemiBold"
                                FlowDirection="LeftToRight"
                                Foreground="{ThemeResource SuccessFillColorDefaultBrush}"
                                Text="{x:Bind ViewModel.TodayUploadText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="TodayTotalCard"
                        Grid.Column="2"
                        Padding="14,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="12"
                                Opacity="0.6"
                                Text="{x:Bind ViewModel.TotalLabel, Mode=OneWay}" />
                            <TextBlock
                                FontSize="24"
                                FontWeight="SemiBold"
                                FlowDirection="LeftToRight"
                                Text="{x:Bind ViewModel.TodayTotalText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock
                    x:Name="MonthSectionHeader"
                    Margin="0,0,0,6"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Opacity="0.6"
                    Text="{x:Bind ViewModel.ThisMonthLabel, Mode=OneWay}" />

                <Grid x:Name="MonthSummaryGrid" Margin="0,0,0,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="MonthDownloadCard"
                        Grid.Column="0"
                        Padding="14,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="12"
                                Opacity="0.6"
                                Text="{x:Bind ViewModel.DownloadLabel, Mode=OneWay}" />
                            <TextBlock
                                FontSize="24"
                                FontWeight="SemiBold"
                                FlowDirection="LeftToRight"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Text="{x:Bind ViewModel.MonthDownloadText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="MonthUploadCard"
                        Grid.Column="1"
                        Padding="14,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="12"
                                Opacity="0.6"
                                Text="{x:Bind ViewModel.UploadLabel, Mode=OneWay}" />
                            <TextBlock
                                FontSize="24"
                                FontWeight="SemiBold"
                                FlowDirection="LeftToRight"
                                Foreground="{ThemeResource SuccessFillColorDefaultBrush}"
                                Text="{x:Bind ViewModel.MonthUploadText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="MonthTotalCard"
                        Grid.Column="2"
                        Padding="14,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="12"
                                Opacity="0.6"
                                Text="{x:Bind ViewModel.TotalLabel, Mode=OneWay}" />
                            <TextBlock
                                FontSize="24"
                                FontWeight="SemiBold"
                                FlowDirection="LeftToRight"
                                Text="{x:Bind ViewModel.MonthTotalText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel
                    x:Name="RangeButtonsPanel"
                    Margin="0,0,0,8"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button
                        x:Name="RangeTodayButton"
                        AutomationProperties.Name="HistoryRangeToday"
                        Click="Range_Click"
                        Tag="0" />
                    <Button
                        x:Name="RangeYesterdayButton"
                        AutomationProperties.Name="HistoryRangeYesterday"
                        Click="Range_Click"
                        Tag="1" />
                    <Button
                        x:Name="RangeLast7Button"
                        AutomationProperties.Name="HistoryRangeLast7"
                        Click="Range_Click"
                        Tag="2" />
                    <Button
                        x:Name="RangeLast30Button"
                        AutomationProperties.Name="HistoryRangeLast30"
                        Click="Range_Click"
                        Tag="3" />
                    <Button
                        x:Name="RangeLifetimeButton"
                        AutomationProperties.Name="HistoryRangeLifetime"
                        Click="Range_Click"
                        Tag="4" />
                    <Button
                        x:Name="RangeThisMonthButton"
                        AutomationProperties.Name="HistoryRangeThisMonth"
                        Click="Range_Click"
                        Tag="5" />
                </StackPanel>

                <TextBlock
                    x:Name="ChartTitleText"
                    Margin="0,0,0,6"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Opacity="0.6"
                    Text="{x:Bind ViewModel.ChartTitleLabel, Mode=OneWay}" />

                <StackPanel
                    x:Name="ChartLegendPanel"
                    Margin="0,0,0,6"
                    Orientation="Horizontal"
                    Spacing="0">
                    <Border
                        Width="10"
                        Height="10"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="2" />
                    <TextBlock
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Opacity="0.6"
                        Text="{x:Bind ViewModel.DownloadLabel, Mode=OneWay}" />
                    <Border
                        Width="10"
                        Height="10"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SuccessFillColorDefaultBrush}"
                        CornerRadius="2" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Opacity="0.6"
                        Text="{x:Bind ViewModel.UploadLabel, Mode=OneWay}" />
                </StackPanel>

                <Border
                    x:Name="ChartCard"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <controls:HistoryBarChart
                            x:Name="HistoryChart"
                            Height="200"
                            Points="{x:Bind ViewModel.Series, Mode=OneWay}"
                            YAxisMax="{x:Bind ViewModel.ScaleMax, Mode=OneWay}" />
                        <TextBlock
                            x:Name="ChartEmptyText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0.6"
                            Text="{x:Bind ViewModel.NoDataText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <Border
                    x:Name="ComparisonCard"
                    Margin="0,10,0,0"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasComparison, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.6"
                            Text="{x:Bind ViewModel.TodayVsYesterdayLabel, Mode=OneWay}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" FlowDirection="LeftToRight">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Opacity="0.6"
                                    Text="{x:Bind ViewModel.TodayLabel, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Text="{x:Bind ViewModel.ComparisonTodayText, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" FlowDirection="LeftToRight">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Opacity="0.6"
                                    Text="{x:Bind ViewModel.YesterdayAtThisTimeLabel, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.ComparisonYesterdayText, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" FlowDirection="LeftToRight">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Opacity="0.6"
                                    Text="{x:Bind ViewModel.DifferenceLabel, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Text="{x:Bind ViewModel.ComparisonDifferenceText, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.6"
                                    Text="{x:Bind ViewModel.ComparisonPercentageText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel
                    x:Name="ExportPanel"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button
                        x:Name="ExportCsvButton"
                        AutomationProperties.Name="HistoryExportCsv"
                        Click="ExportCsv_Click" />
                    <TextBlock
                        x:Name="ExportStatusText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Text="{x:Bind ViewModel.ExportStatusText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasExportStatus, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
