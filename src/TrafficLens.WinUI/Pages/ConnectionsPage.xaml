<Page
    x:Class="TrafficLens.WinUI.Pages.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:TrafficLens.WinUI.Infrastructure"
    xmlns:viewModels="using:TrafficLens.WinUI.ViewModels">

    <Page.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid x:Name="ConnectionsRoot">
        <ScrollViewer
            x:Name="PageScroller"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="RootLayout"
                Margin="16,12,16,12"
                Spacing="0">

                <TextBlock
                    x:Name="PageTitleText"
                    Margin="0,0,0,8"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Opacity="0.6"
                    Text="{x:Bind ViewModel.ConnectionsLabel, Mode=OneWay}" />

                <Border
                    x:Name="ErrorBanner"
                    Margin="0,0,0,10"
                    Padding="12,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="ErrorTitleText"
                            FontSize="12"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            Text="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}" />
                        <TextBlock
                            x:Name="ErrorDetailText"
                            FontSize="11"
                            Opacity="0.6"
                            TextWrapping="Wrap"
                            Text="{x:Bind ViewModel.ErrorDetail, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Grid
                    x:Name="FiltersGrid"
                    Margin="0,0,0,8"
                    ColumnSpacing="8"
                    RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="ShowLabel"
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Opacity="0.6"
                        Text="{x:Bind ViewModel.ShowLabel, Mode=OneWay}" />
                    <ComboBox
                        x:Name="FilterComboBox"
                        Grid.Row="0"
                        Grid.Column="1"
                        MinWidth="130"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.FilterOptions, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}" />

                    <TextBlock
                        x:Name="AddressFamilyLabel"
                        Grid.Row="0"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Opacity="0.6"
                        Text="{x:Bind ViewModel.AddressFamilyLabel, Mode=OneWay}" />
                    <ComboBox
                        x:Name="FamilyFilterComboBox"
                        Grid.Row="0"
                        Grid.Column="3"
                        MinWidth="100"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.FamilyFilterOptions, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.FamilyFilterIndex, Mode=TwoWay}" />

                    <TextBlock
                        x:Name="SortByLabel"
                        Grid.Row="0"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Opacity="0.6"
                        Text="{x:Bind ViewModel.SortByLabel, Mode=OneWay}" />
                    <ComboBox
                        x:Name="SortComboBox"
                        Grid.Row="0"
                        Grid.Column="5"
                        MinWidth="160"
                        HorizontalAlignment="Left"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.SortOptions, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" />

                    <CheckBox
                        x:Name="HideListenersCheckBox"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="ConnectionsHideListeners"
                        Content="{x:Bind ViewModel.HideListenersLabel, Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.HideListeners, Mode=TwoWay}" />
                </Grid>

                <TextBox
                    x:Name="SearchBox"
                    Margin="0,0,0,8"
                    MinWidth="200"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                    TextChanged="SearchBox_TextChanged" />

                <Border
                    x:Name="EmptyStateBorder"
                    Margin="0,0,0,8"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        x:Name="NoActiveConnectionsText"
                        Opacity="0.6"
                        Text="{x:Bind ViewModel.NoActiveConnectionsText, Mode=OneWay}" />
                </Border>

                <Border
                    x:Name="HeaderRow"
                    Padding="10,7,10,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,1,0"
                    CornerRadius="8,8,0,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.4*" MinWidth="100" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="1.3*" MinWidth="100" />
                            <ColumnDefinition Width="1.6*" MinWidth="120" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="ProcessHeader"
                            Grid.Column="0"
                            FontSize="10"
                            Opacity="0.6"
                            TextTrimming="CharacterEllipsis"
                            Text="{x:Bind ViewModel.ProcessLabel, Mode=OneWay}" />
                        <TextBlock
                            x:Name="PidHeader"
                            Grid.Column="1"
                            FontSize="10"
                            Opacity="0.6"
                            TextTrimming="CharacterEllipsis"
                            Text="{x:Bind ViewModel.PidLabel, Mode=OneWay}" />
                        <TextBlock
                            x:Name="ProtocolHeader"
                            Grid.Column="2"
                            FontSize="10"
                            Opacity="0.6"
                            TextTrimming="CharacterEllipsis"
                            Text="{x:Bind ViewModel.ProtocolLabel, Mode=OneWay}" />
                        <TextBlock
                            x:Name="StateHeader"
                            Grid.Column="3"
                            FontSize="10"
                            Opacity="0.6"
                            TextTrimming="CharacterEllipsis"
                            Text="{x:Bind ViewModel.StateLabel, Mode=OneWay}" />
                        <TextBlock
                            x:Name="LocalHeader"
                            Grid.Column="4"
                            FontSize="10"
                            Opacity="0.6"
                            TextTrimming="CharacterEllipsis"
                            Text="{x:Bind ViewModel.LocalEndpointLabel, Mode=OneWay}" />
                        <TextBlock
                            x:Name="RemoteHeader"
                            Grid.Column="5"
                            FontSize="10"
                            Opacity="0.6"
                            TextTrimming="CharacterEllipsis"
                            Text="{x:Bind ViewModel.RemoteEndpointLabel, Mode=OneWay}" />
                    </Grid>
                </Border>

                <ItemsControl
                    x:Name="ConnectionList"
                    ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ConnectionRowViewModel">
                            <Border
                                Margin="0,0,0,5"
                                Padding="10,6,10,6"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            AutomationProperties.Name="CopyLocalEndpoint"
                                            Click="CopyLocalEndpoint_Click"
                                            Text="{Binding DataContext.CopyLocalEndpointLabel, ElementName=ConnectionsRoot}" />
                                        <MenuFlyoutItem
                                            AutomationProperties.Name="CopyRemoteEndpoint"
                                            Click="CopyRemoteEndpoint_Click"
                                            Text="{Binding DataContext.CopyRemoteEndpointLabel, ElementName=ConnectionsRoot}" />
                                        <MenuFlyoutItem
                                            AutomationProperties.Name="CopyRemoteIp"
                                            Click="CopyRemoteIp_Click"
                                            Text="{Binding DataContext.CopyRemoteIpLabel, ElementName=ConnectionsRoot}" />
                                        <MenuFlyoutItem
                                            AutomationProperties.Name="CopyProcessName"
                                            Click="CopyProcessName_Click"
                                            Text="{Binding DataContext.CopyProcessNameLabel, ElementName=ConnectionsRoot}" />
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.4*" MinWidth="100" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="1.3*" MinWidth="100" />
                                        <ColumnDefinition Width="1.6*" MinWidth="120" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Image
                                            Width="18"
                                            Height="18"
                                            VerticalAlignment="Center"
                                            Source="{x:Bind Icon, Mode=OneWay}"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FlowDirection="LeftToRight"
                                        Text="{x:Bind PidText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Bind ProtocolText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FlowDirection="LeftToRight"
                                        Opacity="0.6"
                                        Text="{x:Bind StateText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FlowDirection="LeftToRight"
                                        Text="{x:Bind LocalText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />

                                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="12"
                                            FlowDirection="LeftToRight"
                                            Text="{x:Bind RemoteText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
