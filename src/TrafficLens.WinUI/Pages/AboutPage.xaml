<Page
    x:Class="TrafficLens.WinUI.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="AboutRoot">
        <ScrollViewer
            x:Name="PageScroller"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="RootLayout"
                Margin="16,12,16,12"
                Spacing="0">

                <TextBlock
                    x:Name="PageTitleText"
                    Margin="0,0,0,8"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Opacity="0.6" />

                <Border
                    Margin="0,0,0,12"
                    Padding="16,14"
                    MaxWidth="640"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Image
                                x:Name="AppIconImage"
                                Width="64"
                                Height="64"
                                AutomationProperties.Name="AboutBrandIcon"
                                Stretch="Uniform" />

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    x:Name="ProductNameText"
                                    AutomationProperties.Name="AboutProductName"
                                    FontSize="22"
                                    FontWeight="SemiBold" />

                                <StackPanel
                                    FlowDirection="LeftToRight"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <TextBlock
                                        x:Name="VersionLabelText"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Opacity="0.6" />
                                    <TextBlock
                                        x:Name="VersionValueText"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Opacity="0.6" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock
                            x:Name="DescriptionText"
                            FontSize="12"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,0,0,12"
                    Padding="12,10"
                    MaxWidth="640"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            x:Name="RuntimeLabelText"
                            Margin="0,0,12,8"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.6" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            x:Name="RuntimeValueText"
                            Margin="0,0,0,8"
                            FlowDirection="LeftToRight"
                            FontSize="11"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            x:Name="OsLabelText"
                            Margin="0,0,12,8"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.6" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            x:Name="OsValueText"
                            Margin="0,0,0,8"
                            FlowDirection="LeftToRight"
                            FontSize="11"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            x:Name="CultureLabelText"
                            Margin="0,0,12,8"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.6" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            x:Name="CultureValueText"
                            Margin="0,0,0,8"
                            FontSize="11"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            x:Name="VersionDetailLabelText"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.6" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            x:Name="VersionDetailValueText"
                            FlowDirection="LeftToRight"
                            FontSize="11"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border
                    Padding="12,10"
                    MaxWidth="640"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="DiagnosticsHeaderText"
                            Margin="0,0,0,4"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.6" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                x:Name="DataPathLabelText"
                                Margin="0,0,12,8"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.6" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                x:Name="DataPathValueText"
                                AutomationProperties.Name="AboutDataPath"
                                Margin="0,0,0,8"
                                FlowDirection="LeftToRight"
                                FontSize="11"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                x:Name="SettingsPathLabelText"
                                Margin="0,0,12,8"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.6" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                x:Name="SettingsPathValueText"
                                AutomationProperties.Name="AboutSettingsPath"
                                Margin="0,0,0,8"
                                FlowDirection="LeftToRight"
                                FontSize="11"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                x:Name="LogsPathLabelText"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.6" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                x:Name="LogsPathValueText"
                                AutomationProperties.Name="AboutLogsPath"
                                FlowDirection="LeftToRight"
                                FontSize="11"
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
