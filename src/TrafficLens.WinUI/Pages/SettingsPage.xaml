<Page
    x:Class="TrafficLens.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:TrafficLens.WinUI.Pages">

    <ScrollViewer Padding="24,20,24,24">
        <StackPanel MaxWidth="720" Spacing="24">
            <TextBlock
                x:Name="PageTitleText"
                FontSize="28"
                FontWeight="SemiBold"
                Text="Settings" />

            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="GeneralHeaderText"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="General" />

                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="LanguageLabelText"
                        Opacity="0.85"
                        Text="Language" />
                    <ComboBox
                        x:Name="LanguageCombo"
                        MinWidth="220"
                        HorizontalAlignment="Left"
                        SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem Content="English" Tag="en-US" />
                        <ComboBoxItem Content="فارسی" Tag="fa-IR" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="SystemTrayHeaderText"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="System Tray" />

                <ToggleSwitch
                    x:Name="MinimizeToTrayToggle"
                    OffContent=""
                    OnContent=""
                    Toggled="MinimizeToTrayToggle_Toggled" />

                <ToggleSwitch
                    x:Name="CloseToTrayToggle"
                    OffContent=""
                    OnContent=""
                    Toggled="CloseToTrayToggle_Toggled" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="WidgetHeaderText"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Floating Widget" />

                <ToggleSwitch
                    x:Name="ShowWidgetToggle"
                    OffContent=""
                    OnContent=""
                    Toggled="ShowWidgetToggle_Toggled" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
