<Page
    x:Class="TrafficLens.WinUI.Pages.ApplicationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:TrafficLens.WinUI.Infrastructure"
    xmlns:viewModels="using:TrafficLens.WinUI.ViewModels">

    <Page.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer
        x:Name="PageScroller"
        HorizontalScrollBarVisibility="Auto"
        HorizontalScrollMode="Auto"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <StackPanel
            x:Name="RootLayout"
            Margin="16,12,16,12"
            Spacing="0">

            <TextBlock
                x:Name="PageTitleText"
                Margin="0,0,0,8"
                FontSize="12"
                FontWeight="SemiBold"
                Opacity="0.6"
                Text="{x:Bind ViewModel.ApplicationsLabel, Mode=OneWay}" />

            <Border
                x:Name="StatusBanner"
                Margin="0,0,0,10"
                Padding="12,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.IsStatusBannerVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid ColumnSpacing="10" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="StatusText"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                    <Button
                        x:Name="RestartAdminButton"
                        Grid.Column="1"
                        Grid.Row="0"
                        Padding="10,4"
                        Click="RestartAdmin_Click"
                        Content="{x:Bind ViewModel.RestartAsAdministratorLabel, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsPermissionDenied, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Button
                        x:Name="StartMonitoringButton"
                        Grid.Column="1"
                        Grid.Row="0"
                        Padding="10,4"
                        Click="StartMonitoring_Click"
                        Content="{x:Bind ViewModel.StartMonitoringLabel, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsStartMonitoringVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        x:Name="StatusDetailText"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Grid.Row="1"
                        FontSize="11"
                        Opacity="0.6"
                        TextWrapping="Wrap"
                        Text="{x:Bind ViewModel.StatusDetailText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasStatusDetail, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <Grid x:Name="SummaryGrid" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="IdleCard"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        x:Name="NoActiveTrafficText"
                        Opacity="0.6"
                        Text="{x:Bind ViewModel.NoActiveTrafficText, Mode=OneWay}" />
                </Border>

                <Border
                    x:Name="TopConsumerCard"
                    Grid.Column="0"
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasActiveTraffic, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="0">
                        <TextBlock
                            x:Name="TopConsumerNowLabel"
                            Margin="0,0,0,4"
                            FontSize="11"
                            Opacity="0.6"
                            Text="{x:Bind ViewModel.TopConsumerNowLabel, Mode=OneWay}" />
                        <StackPanel Margin="0,0,0,6" Orientation="Horizontal" Spacing="8">
                            <Image
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Source="{x:Bind ViewModel.TopConsumerIcon, Mode=OneWay}"
                                Stretch="Uniform" />
                            <TextBlock
                                x:Name="TopConsumerName"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                MaxLines="2"
                                TextWrapping="Wrap"
                                TextTrimming="CharacterEllipsis"
                                Text="{x:Bind ViewModel.TopConsumerName, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Text="↓" />
                            <TextBlock
                                x:Name="TopConsumerDownloadRateText"
                                Margin="4,0,10,0"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                Text="{x:Bind ViewModel.TopConsumerDownloadRateText, Mode=OneWay}" />
                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource SuccessFillColorDefaultBrush}" Text="↑" />
                            <TextBlock
                                x:Name="TopConsumerUploadRateText"
                                Margin="4,0,0,0"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                Text="{x:Bind ViewModel.TopConsumerUploadRateText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal" FlowDirection="LeftToRight">
                            <TextBlock
                                x:Name="TotalLabel"
                                FontSize="11"
                                Opacity="0.6"
                                Text="{x:Bind ViewModel.TotalLabel, Mode=OneWay}" />
                            <TextBlock
                                x:Name="TopConsumerTotalRateText"
                                Margin="4,0,0,0"
                                FontSize="11"
                                FlowDirection="LeftToRight"
                                Opacity="0.6"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                Text="{x:Bind ViewModel.TopConsumerTotalRateText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="TopDownloadCard"
                    Grid.Column="1"
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasActiveTraffic, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="0">
                        <TextBlock
                            x:Name="TopDownloadLabel"
                            Margin="0,0,0,4"
                            FontSize="11"
                            Opacity="0.6"
                            Text="{x:Bind ViewModel.TopDownloadLabel, Mode=OneWay}" />
                        <StackPanel Margin="0,0,0,6" Orientation="Horizontal" Spacing="8">
                            <Image
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Source="{x:Bind ViewModel.TopDownloadIcon, Mode=OneWay}"
                                Stretch="Uniform" />
                            <TextBlock
                                x:Name="TopDownloadName"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                MaxLines="2"
                                TextWrapping="Wrap"
                                TextTrimming="CharacterEllipsis"
                                Text="{x:Bind ViewModel.TopDownloadName, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Text="↓" />
                            <TextBlock
                                x:Name="TopDownloadRateText"
                                Margin="4,0,0,0"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                Text="{x:Bind ViewModel.TopDownloadRateText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="TopUploadCard"
                    Grid.Column="2"
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasActiveTraffic, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="0">
                        <TextBlock
                            x:Name="TopUploadLabel"
                            Margin="0,0,0,4"
                            FontSize="11"
                            Opacity="0.6"
                            Text="{x:Bind ViewModel.TopUploadLabel, Mode=OneWay}" />
                        <StackPanel Margin="0,0,0,6" Orientation="Horizontal" Spacing="8">
                            <Image
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Source="{x:Bind ViewModel.TopUploadIcon, Mode=OneWay}"
                                Stretch="Uniform" />
                            <TextBlock
                                x:Name="TopUploadName"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                MaxLines="2"
                                TextWrapping="Wrap"
                                TextTrimming="CharacterEllipsis"
                                Text="{x:Bind ViewModel.TopUploadName, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource SuccessFillColorDefaultBrush}" Text="↑" />
                            <TextBlock
                                x:Name="TopUploadRateText"
                                Margin="4,0,0,0"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                Text="{x:Bind ViewModel.TopUploadRateText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="SortSearchGrid" Margin="0,12,0,8" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="SortByLabel"
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.6"
                    Text="{x:Bind ViewModel.SortByLabel, Mode=OneWay}" />
                <ComboBox
                    x:Name="SortComboBox"
                    Grid.Row="0"
                    Grid.Column="1"
                    MinWidth="180"
                    MaxWidth="280"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Bind ViewModel.SortOptions, Mode=OneWay}"
                    SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" />

                <TextBox
                    x:Name="SearchBox"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    MinWidth="200"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                    TextChanged="SearchBox_TextChanged" />
            </Grid>

            <Border
                x:Name="HeaderRow"
                Padding="10,7,10,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="8,8,0,0">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.4*" MinWidth="100" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="1.1*" MinWidth="72" />
                        <ColumnDefinition Width="1.1*" MinWidth="72" />
                        <ColumnDefinition Width="1.1*" MinWidth="72" />
                        <ColumnDefinition Width="1.1*" MinWidth="68" />
                        <ColumnDefinition Width="1.1*" MinWidth="68" />
                        <ColumnDefinition Width="1.1*" MinWidth="68" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="ProcessHeader"
                        Grid.Column="0"
                        FontSize="10"
                        Opacity="0.6"
                        TextTrimming="CharacterEllipsis"
                        Text="{x:Bind ViewModel.ProcessLabel, Mode=OneWay}" />
                    <TextBlock
                        x:Name="PidHeader"
                        Grid.Column="1"
                        FontSize="10"
                        Opacity="0.6"
                        TextTrimming="CharacterEllipsis"
                        Text="{x:Bind ViewModel.PidLabel, Mode=OneWay}" />
                    <TextBlock
                        x:Name="StateHeader"
                        Grid.Column="2"
                        FontSize="10"
                        Opacity="0.6"
                        TextTrimming="CharacterEllipsis"
                        Text="{x:Bind ViewModel.ProcessStateLabel, Mode=OneWay}" />
                    <TextBlock
                        x:Name="CurrentSpeedHeader"
                        Grid.Column="3"
                        Grid.ColumnSpan="3"
                        FontSize="10"
                        Opacity="0.6"
                        TextTrimming="CharacterEllipsis"
                        Text="{x:Bind ViewModel.CurrentSpeedLabel, Mode=OneWay}" />
                    <TextBlock
                        x:Name="TotalTransferredHeader"
                        Grid.Column="6"
                        Grid.ColumnSpan="3"
                        FontSize="10"
                        Opacity="0.6"
                        TextTrimming="CharacterEllipsis"
                        Text="{x:Bind ViewModel.TotalTransferredLabel, Mode=OneWay}" />
                </Grid>
            </Border>

            <ItemsControl
                x:Name="ProcessList"
                ItemsSource="{x:Bind ViewModel.Processes, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ProcessRowViewModel">
                        <Border
                            Margin="0,0,0,5"
                            Padding="10,6,10,6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.4*" MinWidth="100" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="1.1*" MinWidth="72" />
                                    <ColumnDefinition Width="1.1*" MinWidth="72" />
                                    <ColumnDefinition Width="1.1*" MinWidth="72" />
                                    <ColumnDefinition Width="1.1*" MinWidth="68" />
                                    <ColumnDefinition Width="1.1*" MinWidth="68" />
                                    <ColumnDefinition Width="1.1*" MinWidth="68" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Image
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Source="{x:Bind Icon, Mode=OneWay}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FlowDirection="LeftToRight"
                                    Text="{x:Bind PidText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Opacity="0.6"
                                    Text="{x:Bind StateText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" FlowDirection="LeftToRight">
                                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Text="↓" />
                                    <TextBlock
                                        Margin="3,0,0,0"
                                        FontSize="12"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{x:Bind DownloadRateText, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Orientation="Horizontal" FlowDirection="LeftToRight">
                                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource SuccessFillColorDefaultBrush}" Text="↑" />
                                    <TextBlock
                                        Margin="3,0,0,0"
                                        FontSize="12"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{x:Bind UploadRateText, Mode=OneWay}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="5"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FlowDirection="LeftToRight"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{x:Bind TotalRateText, Mode=OneWay}" />

                                <StackPanel Grid.Column="6" VerticalAlignment="Center" Orientation="Horizontal" FlowDirection="LeftToRight">
                                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Text="↓" />
                                    <TextBlock
                                        Margin="3,0,0,0"
                                        FontSize="12"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{x:Bind DownloadText, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="7" VerticalAlignment="Center" Orientation="Horizontal" FlowDirection="LeftToRight">
                                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource SuccessFillColorDefaultBrush}" Text="↑" />
                                    <TextBlock
                                        Margin="3,0,0,0"
                                        FontSize="12"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{x:Bind UploadText, Mode=OneWay}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="8"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FlowDirection="LeftToRight"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{x:Bind TotalText, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
