<Page
    x:Class="TrafficLens.WinUI.Pages.ApplicationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:TrafficLens.WinUI.Infrastructure"
    xmlns:viewModels="using:TrafficLens.WinUI.ViewModels">

    <Page.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <StackPanel
            x:Name="RootLayout"
            Margin="20,14,20,12"
            Spacing="0">

            <TextBlock
                x:Name="PageTitleText"
                Margin="0,0,0,10"
                FontSize="12"
                FontWeight="SemiBold"
                Opacity="0.6"
                Text="Applications" />

            <Border
                x:Name="StatusBanner"
                Margin="0,0,0,12"
                Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.IsStatusBannerVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock
                        x:Name="StatusText"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                    <TextBlock
                        x:Name="StatusDetailText"
                        Margin="0,4,0,0"
                        FontSize="11"
                        Opacity="0.6"
                        TextWrapping="Wrap"
                        Text="{x:Bind ViewModel.StatusDetailText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasStatusDetail, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <StackPanel
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Visibility="{x:Bind ViewModel.IsPermissionDenied, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Button
                            x:Name="RestartAdminButton"
                            Click="RestartAdmin_Click"
                            Content="{x:Bind ViewModel.RestartAsAdministratorLabel, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Visibility="{x:Bind ViewModel.IsStartMonitoringVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Button
                            x:Name="StartMonitoringButton"
                            Click="StartMonitoring_Click"
                            Content="{x:Bind ViewModel.StartMonitoringLabel, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid x:Name="SummaryGrid" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="IdleCard"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        x:Name="NoActiveTrafficText"
                        Opacity="0.6"
                        Text="{x:Bind ViewModel.NoActiveTrafficText, Mode=OneWay}" />
                </Border>

                <Border
                    x:Name="TopConsumerCard"
                    Grid.Column="0"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasActiveTraffic, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock
                            x:Name="TopConsumerNowLabel"
                            Margin="0,0,0,6"
                            FontSize="12"
                            Opacity="0.6"
                            Text="{x:Bind ViewModel.TopConsumerNowLabel, Mode=OneWay}" />
                        <TextBlock
                            x:Name="TopConsumerName"
                            Margin="0,0,0,8"
                            FontSize="18"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            Text="{x:Bind ViewModel.TopConsumerName, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Text="↓" />
                            <TextBlock
                                x:Name="TopConsumerDownloadRateText"
                                Margin="4,0,12,0"
                                Text="{x:Bind ViewModel.TopConsumerDownloadRateText, Mode=OneWay}" />
                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource SuccessFillColorDefaultBrush}" Text="↑" />
                            <TextBlock
                                x:Name="TopConsumerUploadRateText"
                                Margin="4,0,12,0"
                                Text="{x:Bind ViewModel.TopConsumerUploadRateText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal" FlowDirection="LeftToRight">
                            <TextBlock
                                x:Name="TotalLabel"
                                FontSize="11"
                                Opacity="0.6"
                                Text="{x:Bind ViewModel.TotalLabel, Mode=OneWay}" />
                            <TextBlock
                                x:Name="TopConsumerTotalRateText"
                                Margin="4,0,0,0"
                                FontSize="11"
                                FlowDirection="LeftToRight"
                                Opacity="0.6"
                                Text="{x:Bind ViewModel.TopConsumerTotalRateText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="TopDownloadCard"
                    Grid.Column="1"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasActiveTraffic, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock
                            x:Name="TopDownloadLabel"
                            Margin="0,0,0,6"
                            FontSize="12"
                            Opacity="0.6"
                            Text="{x:Bind ViewModel.TopDownloadLabel, Mode=OneWay}" />
                        <TextBlock
                            x:Name="TopDownloadName"
                            Margin="0,0,0,8"
                            FontSize="15"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            Text="{x:Bind ViewModel.TopDownloadName, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Text="↓" />
                            <TextBlock
                                x:Name="TopDownloadRateText"
                                Margin="4,0,0,0"
                                Text="{x:Bind ViewModel.TopDownloadRateText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="TopUploadCard"
                    Grid.Column="2"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasActiveTraffic, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock
                            x:Name="TopUploadLabel"
                            Margin="0,0,0,6"
                            FontSize="12"
                            Opacity="0.6"
                            Text="{x:Bind ViewModel.TopUploadLabel, Mode=OneWay}" />
                        <TextBlock
                            x:Name="TopUploadName"
                            Margin="0,0,0,8"
                            FontSize="15"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            Text="{x:Bind ViewModel.TopUploadName, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource SuccessFillColorDefaultBrush}" Text="↑" />
                            <TextBlock
                                x:Name="TopUploadRateText"
                                Margin="4,0,0,0"
                                Text="{x:Bind ViewModel.TopUploadRateText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,16,0,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="SortByLabel"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.6"
                    Text="{x:Bind ViewModel.SortByLabel, Mode=OneWay}" />
                <ComboBox
                    x:Name="SortComboBox"
                    Grid.Column="1"
                    MinWidth="180"
                    Margin="8,0,8,0"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Bind ViewModel.SortOptions, Mode=OneWay}"
                    SelectedValue="{x:Bind ViewModel.SortKey, Mode=TwoWay}"
                    SelectedValuePath="Key" />
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="2"
                    MinWidth="200"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                    TextChanged="SearchBox_TextChanged" />
            </Grid>

            <Border
                x:Name="HeaderRow"
                Padding="8,8,8,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="8,8,0,0">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="ProcessHeader"
                        Grid.Column="0"
                        FontSize="10"
                        Opacity="0.6"
                        Text="{x:Bind ViewModel.ProcessLabel, Mode=OneWay}" />
                    <TextBlock
                        x:Name="PidHeader"
                        Grid.Column="1"
                        FontSize="10"
                        Opacity="0.6"
                        Text="{x:Bind ViewModel.PidLabel, Mode=OneWay}" />
                    <TextBlock
                        x:Name="StateHeader"
                        Grid.Column="2"
                        FontSize="10"
                        Opacity="0.6"
                        Text="{x:Bind ViewModel.ProcessStateLabel, Mode=OneWay}" />
                    <TextBlock
                        x:Name="CurrentSpeedHeader"
                        Grid.Column="3"
                        Grid.ColumnSpan="3"
                        FontSize="10"
                        Opacity="0.6"
                        Text="{x:Bind ViewModel.CurrentSpeedLabel, Mode=OneWay}" />
                    <TextBlock
                        x:Name="TotalTransferredHeader"
                        Grid.Column="6"
                        Grid.ColumnSpan="3"
                        FontSize="10"
                        Opacity="0.6"
                        Text="{x:Bind ViewModel.TotalTransferredLabel, Mode=OneWay}" />
                </Grid>
            </Border>

            <ItemsControl
                x:Name="ProcessList"
                ItemsSource="{x:Bind ViewModel.Processes, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ProcessRowViewModel">
                        <Border
                            Margin="0,0,0,6"
                            Padding="8,6,8,6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FlowDirection="LeftToRight"
                                    Text="{x:Bind PidText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Opacity="0.6"
                                    Text="{x:Bind StateText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Column="3" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Text="↓" />
                                    <TextBlock
                                        Margin="3,0,0,0"
                                        FontSize="12"
                                        Text="{x:Bind DownloadRateText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="4" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource SuccessFillColorDefaultBrush}" Text="↑" />
                                    <TextBlock
                                        Margin="3,0,0,0"
                                        FontSize="12"
                                        Text="{x:Bind UploadRateText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="5"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FlowDirection="LeftToRight"
                                    Text="{x:Bind TotalRateText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Column="6" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Text="↓" />
                                    <TextBlock
                                        Margin="3,0,0,0"
                                        FontSize="12"
                                        Text="{x:Bind DownloadText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="7" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource SuccessFillColorDefaultBrush}" Text="↑" />
                                    <TextBlock
                                        Margin="3,0,0,0"
                                        FontSize="12"
                                        Text="{x:Bind UploadText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="8"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FlowDirection="LeftToRight"
                                    Text="{x:Bind TotalText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
