<Page
    x:Class="TrafficLens.WinUI.Pages.AlertsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:TrafficLens.WinUI.Infrastructure"
    xmlns:viewModels="using:TrafficLens.WinUI.ViewModels">

    <Page.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid x:Name="AlertsRoot">
        <ScrollViewer
            x:Name="PageScroller"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="RootLayout"
                Margin="16,12,16,12"
                Spacing="0">

                <TextBlock
                    x:Name="PageTitleText"
                    Margin="0,0,0,8"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Opacity="0.6"
                    Text="{x:Bind ViewModel.AlertsTitleLabel, Mode=OneWay}" />

                <TextBlock
                    x:Name="ConfiguredSectionHeader"
                    Margin="0,0,0,6"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Opacity="0.6"
                    Text="{x:Bind ViewModel.ConfiguredRulesLabel, Mode=OneWay}" />

                <TextBlock
                    x:Name="NoConfiguredRulesText"
                    Margin="0,4,0,12"
                    FontSize="11"
                    HorizontalAlignment="Center"
                    Opacity="0.55"
                    Text="{x:Bind ViewModel.NoConfiguredRulesText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasNoConfiguredRules, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <Border
                    x:Name="RulesCard"
                    Margin="0,0,0,12"
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Rules, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:AlertRuleRowViewModel">
                                    <Grid ColumnSpacing="8" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="78" />
                                        </Grid.ColumnDefinitions>

                                        <ToggleSwitch
                                            Grid.Column="0"
                                            MinWidth="0"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind RuleName, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="10"
                                                Opacity="0.55"
                                                Text="{x:Bind StatusText, Mode=OneWay}" />
                                        </StackPanel>

                                        <TextBox
                                            Grid.Column="2"
                                            Width="88"
                                            FlowDirection="LeftToRight"
                                            FontSize="11"
                                            HorizontalAlignment="Right"
                                            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                            Text="{x:Bind ThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextAlignment="Right" />

                                        <ComboBox
                                            Grid.Column="3"
                                            MinWidth="78"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                            ItemsSource="{x:Bind ActiveUnitOptions, Mode=OneWay}"
                                            SelectedIndex="{x:Bind UnitIndex, Mode=TwoWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Text="{x:Bind ViewModel.CooldownLabel, Mode=OneWay}" />

                            <TextBox
                                Grid.Column="1"
                                Width="72"
                                FlowDirection="LeftToRight"
                                FontSize="11"
                                HorizontalAlignment="Right"
                                Text="{x:Bind ViewModel.CooldownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextAlignment="Right" />

                            <TextBlock
                                Grid.Column="2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.7"
                                Text="{x:Bind ViewModel.MinutesLabel, Mode=OneWay}" />
                        </Grid>

                        <TextBlock
                            FontSize="10"
                            Opacity="0.55"
                            Text="{x:Bind ViewModel.CooldownRangeLabel, Mode=OneWay}" />

                        <TextBlock
                            x:Name="ValidationErrorText"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.ValidationError, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasValidationError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <TextBlock
                            x:Name="SavedNoticeText"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.SavedNotice, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasSavedNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <Button
                            x:Name="SaveRulesButton"
                            HorizontalAlignment="Left"
                            Click="Save_Click"
                            FontWeight="SemiBold"
                            Content="{x:Bind ViewModel.SaveLabel, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <TextBlock
                    x:Name="TriggeredSectionHeader"
                    Margin="0,0,0,6"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Opacity="0.6"
                    Text="{x:Bind ViewModel.TriggeredSectionLabel, Mode=OneWay}" />

                <TextBlock
                    x:Name="AlertCountText"
                    Margin="0,0,0,8"
                    FontSize="11"
                    Opacity="0.55"
                    Text="{x:Bind ViewModel.AlertCountText, Mode=OneWay}" />

                <TextBlock
                    x:Name="NoAlertsText"
                    Margin="0,4,0,8"
                    FontSize="11"
                    HorizontalAlignment="Center"
                    Opacity="0.55"
                    Text="{x:Bind ViewModel.NoAlertsText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasNoAlerts, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.RecentAlerts, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:AlertRecentRowViewModel">
                            <Border
                                Margin="0,0,0,6"
                                Padding="12,10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                            Text="{x:Bind TypeText, Mode=OneTime}" />
                                        <TextBlock
                                            FontSize="10"
                                            Opacity="0.55"
                                            Text="{x:Bind TimeText, Mode=OneTime}" />
                                        <TextBlock
                                            FontSize="10"
                                            FlowDirection="LeftToRight"
                                            Opacity="0.65"
                                            Text="{x:Bind ThresholdText, Mode=OneTime}" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Text="{x:Bind Message, Mode=OneTime}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
