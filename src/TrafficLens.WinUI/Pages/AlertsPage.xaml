<Page
    x:Class="TrafficLens.WinUI.Pages.AlertsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:TrafficLens.WinUI.Infrastructure"
    xmlns:viewModels="using:TrafficLens.WinUI.ViewModels">

    <Page.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </Page.Resources>

    <Grid x:Name="AlertsRoot">
        <ScrollViewer
            x:Name="PageScroller"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="RootLayout"
                Margin="16,12,16,12"
                Spacing="0">

                <TextBlock
                    x:Name="PageTitleText"
                    Margin="0,0,0,8"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Opacity="0.6"
                    Text="{x:Bind ViewModel.AlertsTitleLabel, Mode=OneWay}" />

                <!--
                    The whole editable Alerts configuration lives in ONE parent
                    container: the five rule sections, the cooldown subsection and
                    a full-width footer that owns validation feedback and the single
                    global Save action. Save applies to ALL alert settings, so it
                    must read as belonging to the whole configuration, not to the
                    cooldown subsection. Behaviour, bindings and persistence are
                    unchanged; only the grouping changed.
                -->
                <Border
                    x:Name="AlertsConfigCard"
                    Margin="0,0,0,12"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="0">

                        <TextBlock
                            x:Name="ConfiguredSectionHeader"
                            Margin="0,0,0,6"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.6"
                            Text="{x:Bind ViewModel.ConfiguredRulesLabel, Mode=OneWay}" />

                        <TextBlock
                            x:Name="NoConfiguredRulesText"
                            Margin="0,4,0,12"
                            FontSize="11"
                            HorizontalAlignment="Center"
                            Opacity="0.55"
                            Text="{x:Bind ViewModel.NoConfiguredRulesText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasNoConfiguredRules, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <!--
                            One internal section per alert rule in a native wrapping
                            grid. Every section uses the same item size, so the
                            sections are equal height, equal width and evenly spaced,
                            and the grid reflows to fewer or more columns as the
                            window is resized instead of scrolling horizontally. The
                            rule order and the data behind each section are unchanged.
                        -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Rules, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid
                                Orientation="Horizontal"
                                MaximumRowsOrColumns="4"
                                ItemWidth="216"
                                ItemHeight="120" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:AlertRuleRowViewModel">
                            <Border
                                Margin="0,0,8,8"
                                Padding="12,10"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind RuleName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />

                                        <ToggleSwitch
                                            Grid.Column="1"
                                            MinWidth="0"
                                            VerticalAlignment="Center"
                                            IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                            OffContent=""
                                            OnContent="" />
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="1"
                                        FontSize="10"
                                        Opacity="0.55"
                                        Text="{x:Bind StatusText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />

                                    <!--
                                        The threshold editor sits above the slack row on
                                        purpose. ItemsWrapGrid gives every card the same
                                        fixed height, so any spare room has to be taken by
                                        the trailing star row; when the editor was below it
                                        the row was crushed to a few pixels and the numeric
                                        input could not be seen or clicked.
                                    -->
                                    <Grid
                                        Grid.Row="2"
                                        Margin="0,2,0,0"
                                        ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="78" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            Grid.Column="0"
                                            MinHeight="32"
                                            FlowDirection="LeftToRight"
                                            FontSize="11"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind ThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextAlignment="Right" />

                                        <ComboBox
                                            Grid.Column="1"
                                            MinWidth="78"
                                            MinHeight="32"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            ItemsSource="{x:Bind ActiveUnitOptions, Mode=OneWay}"
                                            SelectedIndex="{x:Bind UnitIndex, Mode=TwoWay}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Divider between the rule sections and the cooldown subsection. -->
                        <Border
                            x:Name="RulesCooldownDivider"
                            Height="1"
                            Margin="0,10"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!--
                            Cooldown is one setting among the overall Alerts settings:
                            a subsection inside the main container. It deliberately
                            does NOT contain the Save button or the save feedback.
                        -->
                        <Border
                            x:Name="CooldownCard"
                            Padding="12,10"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Text="{x:Bind ViewModel.CooldownLabel, Mode=OneWay}" />

                                    <TextBox
                                        Width="72"
                                        FlowDirection="LeftToRight"
                                        FontSize="11"
                                        Text="{x:Bind ViewModel.CooldownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextAlignment="Right" />

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Opacity="0.7"
                                        Text="{x:Bind ViewModel.MinutesLabel, Mode=OneWay}" />
                                </StackPanel>

                                <TextBlock
                                    x:Name="CooldownRangeText"
                                    FontSize="10"
                                    Opacity="0.55"
                                    Text="{x:Bind ViewModel.CooldownRangeLabel, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind ViewModel.HasValidationError, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- Divider between the cooldown subsection and the global action footer. -->
                        <Border
                            x:Name="CooldownFooterDivider"
                            Height="1"
                            Margin="0,10"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!--
                            Full-width global footer of the main configuration
                            container: validation/saved feedback on the flow side and
                            the ONE global Save action on the opposite edge. In RTL
                            (fa-IR) the layout mirrors automatically via the inherited
                            FlowDirection, so Save sits naturally on the left.
                        -->
                        <Grid
                            x:Name="AlertsConfigFooter"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    x:Name="ValidationErrorText"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ViewModel.ValidationError, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.HasValidationError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <TextBlock
                                    x:Name="SavedNoticeText"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Text="{x:Bind ViewModel.SavedNotice, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.HasSavedNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <Button
                                x:Name="SaveRulesButton"
                                Grid.Column="1"
                                MinWidth="110"
                                Padding="20,6"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Click="Save_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="{x:Bind ViewModel.SaveLabel, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--
                    Active (triggered) alerts are informational, NOT part of the
                    editable configuration or the Save action, so they get their own
                    container below the main configuration container.
                -->
                <Border
                    x:Name="ActiveAlertsCard"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="0">

                        <TextBlock
                            x:Name="TriggeredSectionHeader"
                            Margin="0,0,0,6"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.6"
                            Text="{x:Bind ViewModel.TriggeredSectionLabel, Mode=OneWay}" />

                        <TextBlock
                            x:Name="AlertCountText"
                            Margin="0,0,0,8"
                            FontSize="11"
                            Opacity="0.55"
                            Text="{x:Bind ViewModel.AlertCountText, Mode=OneWay}" />

                        <TextBlock
                            x:Name="NoAlertsText"
                            Margin="0,4,0,8"
                            FontSize="11"
                            HorizontalAlignment="Center"
                            Opacity="0.55"
                            Text="{x:Bind ViewModel.NoAlertsText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasNoAlerts, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.RecentAlerts, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:AlertRecentRowViewModel">
                            <Border
                                Margin="0,0,0,6"
                                Padding="12,10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                            Text="{x:Bind TypeText, Mode=OneTime}" />
                                        <TextBlock
                                            FontSize="10"
                                            Opacity="0.55"
                                            Text="{x:Bind TimeText, Mode=OneTime}" />
                                        <TextBlock
                                            FontSize="10"
                                            FlowDirection="LeftToRight"
                                            Opacity="0.65"
                                            Text="{x:Bind ThresholdText, Mode=OneTime}" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Text="{x:Bind Message, Mode=OneTime}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
