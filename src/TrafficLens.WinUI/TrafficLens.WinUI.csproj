<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>TrafficLens.WinUI</RootNamespace>
    <AssemblyName>TrafficLens.WinUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\branding\TrafficLens.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <EnableMsixTooling>false</EnableMsixTooling>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrafficLens.Core\TrafficLens.Core.csproj" />
    <ProjectReference Include="..\TrafficLens.Infrastructure\TrafficLens.Infrastructure.csproj" />
    <ProjectReference Include="..\TrafficLens.Network\TrafficLens.Network.csproj" />
    <ProjectReference Include="..\TrafficLens.WinUI.Tray\TrafficLens.WinUI.Tray.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TrafficLens.App\Services\AlertService.cs" Link="Services\AlertService.cs" />
    <Compile Include="..\TrafficLens.App\Services\AlertSettings.cs" Link="Services\AlertSettings.cs" />
    <Compile Include="..\TrafficLens.App\Services\AlertNotification.cs" Link="Services\AlertNotification.cs" />
    <Compile Include="..\TrafficLens.App\Services\IAlertService.cs" Link="Services\IAlertService.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\TrafficLens.App\Resources\Strings.resx" Link="Resources\Strings.resx" />
    <EmbeddedResource Include="..\TrafficLens.App\Resources\Strings.fa-IR.resx" Link="Resources\Strings.fa-IR.resx" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\branding\TrafficLens-256.png" Link="Assets\TrafficLens-256.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\branding\TrafficLens.ico" Link="Assets\TrafficLens.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\branding\TrafficLens-256.png" LogicalName="TrafficLens.WinUI.Assets.TrafficLens-256.png" />
  </ItemGroup>

  <!--
    Publish the MRT Core generated project PRI.

    MRT Core (Microsoft.Windows.SDK.BuildTools.MSIX.MrtCore.PriGen.targets) writes
    the project PRI straight to $(TargetDir) - i.e. bin/... - and only registers it
    as a publishable ProjectPriFile item when '$(AppxPackage)' == 'true' (MSIX).
    This app is unpackaged (WindowsPackageType=None), so that item is never
    created and 'dotnet publish -o' silently omits TrafficLens.WinUI.pri.

    The compiled XAML (XBF) is packaged only inside that PRI - the managed
    assembly embeds zero XBF resources - so a publish without it produces a
    release that starts, sets its culture, and then dies with
    Microsoft.UI.Xaml.Markup.XamlParseException ("XAML parsing failed") in
    MainWindow.InitializeComponent(). That is exactly how the first v0.1.4 RC
    failed, and it is unrelated to Smart App Control or code signing.

    Add the generated PRI to the publish item list explicitly. Build runs before
    the publish file list is computed (Publish -> _PublishBuildAlternative ->
    Build;$(...) -> ComputeResolvedFilesToPublishList), and Build -> PrepareForRun
    -> _GenerateProjectPriFile, so the file already exists at this point.
  -->
  <Target Name="IncludeProjectPriFileInPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(ProjectPriFullPath)' != '' And '$(ProjectPriFileName)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)"
                             Condition="Exists('$(ProjectPriFullPath)')">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
