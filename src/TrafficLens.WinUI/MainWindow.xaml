<Window
    x:Class="TrafficLens.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TrafficLens.WinUI"
    Title="TrafficLens">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The caption safe area is applied to the title, not to this grid, so the
            quick action in the first column keeps a fixed physical top-left
            position no matter which side the shell puts the caption buttons on (see
            TitleBarCaptionLayout and ApplyCaptionSafeArea).
        -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="0"
            FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                Quick access to the Floating Widget from the persistent shell, so it
                is available on every page. This grid is pinned to left-to-right on
                purpose: it keeps the control physically in the top-left corner in
                both layout directions, which in Persian is the side opposite the
                navigation pane. The control is anchored by the first column, so its
                position depends only on the window's own left edge and stays put
                across resize, maximize, restore, pane collapse and page changes.
                The title keeps its own direction, applied in code, so the
                right-to-left title still sits against the navigation edge.
            -->
            <ToggleButton
                x:Name="WidgetQuickToggle"
                Grid.Column="0"
                Height="32"
                Margin="12,0,12,0"
                Padding="10,0,12,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="12"
                Click="WidgetQuickToggle_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="14"
                        Glyph="&#xE992;" />
                    <TextBlock
                        x:Name="WidgetQuickToggleLabel"
                        VerticalAlignment="Center"
                        Text="Floating Widget" />
                </StackPanel>
            </ToggleButton>

            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Text="TrafficLens"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="DashboardNavItem"
                    Content="Dashboard"
                    Tag="Dashboard"
                    ToolTipService.ToolTip="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ApplicationsNavItem"
                    Content="Applications"
                    Tag="Applications"
                    ToolTipService.ToolTip="Applications">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ConnectionsNavItem"
                    Content="Connections"
                    Tag="Connections"
                    ToolTipService.ToolTip="Connections">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="HistoryNavItem"
                    Content="History"
                    Tag="History"
                    ToolTipService.ToolTip="History">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AlertsNavItem"
                    Content="Alerts"
                    Tag="Alerts"
                    ToolTipService.ToolTip="Alerts">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7BA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="SettingsNavItem"
                    Content="Settings"
                    Tag="Settings"
                    ToolTipService.ToolTip="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AboutNavItem"
                    Content="About"
                    Tag="About"
                    ToolTipService.ToolTip="About">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
