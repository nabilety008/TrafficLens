<Window
    x:Class="TrafficLens.WinUI.Views.FloatingWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:TrafficLens.WinUI.Views"
    Title="TrafficLens">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Border
            x:Name="RootBorder"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            PointerPressed="OnPointerPressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased">
            <Grid Margin="10,4,10,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" MinHeight="32" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="PinButton"
                        Grid.Column="0"
                        Click="PinButton_Click"
                        FontSize="11"
                        MinWidth="20"
                        MinHeight="24"
                        Padding="4,1"
                        Background="Transparent"
                        BorderThickness="0" />

                    <TextBlock
                        x:Name="TitleText"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.75"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="&#8595;" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="DownloadLabelText" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                        <TextBlock x:Name="DownloadValueText" FlowDirection="LeftToRight" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="&#8593;" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SuccessFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="UploadLabelText" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                        <TextBlock x:Name="UploadValueText" FlowDirection="LeftToRight" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SuccessFillColorDefaultBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="&#8693;" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="TotalLabelText" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                        <TextBlock x:Name="TotalValueText" FlowDirection="LeftToRight" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
