<Window
    x:Class="TrafficLens.WinUI.Views.FloatingWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:TrafficLens.WinUI.Views"
    Title="TrafficLens">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Border
            x:Name="RootBorder"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            PointerPressed="OnPointerPressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased">
            <Grid Margin="14,10" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="TitleText"
                        Grid.Column="0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Opacity="0.75"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <Button
                            x:Name="PinButton"
                            Click="PinButton_Click"
                            FontSize="12"
                            MinWidth="24"
                            Padding="6,2"
                            Background="Transparent"
                            BorderThickness="0" />
                        <Button
                            x:Name="CloseButton"
                            Click="CloseButton_Click"
                            FontSize="12"
                            MinWidth="24"
                            Padding="6,2"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="&#10005;" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#8595;" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="DownloadLabelText" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
                        <TextBlock x:Name="DownloadValueText" FlowDirection="LeftToRight" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#8593;" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource SuccessFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="UploadLabelText" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
                        <TextBlock x:Name="UploadValueText" FlowDirection="LeftToRight" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource SuccessFillColorDefaultBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#8693;" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="TotalLabelText" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
                        <TextBlock x:Name="TotalValueText" FlowDirection="LeftToRight" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
