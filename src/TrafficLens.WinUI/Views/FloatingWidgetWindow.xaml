<Window
    x:Class="TrafficLens.WinUI.Views.FloatingWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:TrafficLens.WinUI.Views"
    Title="TrafficLens">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Border
            x:Name="RootBorder"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            PointerPressed="OnPointerPressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased">
            <Grid Margin="10,8" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="TitleText"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.75"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                        <Button
                            x:Name="PinButton"
                            Click="PinButton_Click"
                            FontSize="11"
                            Padding="4,1"
                            Background="Transparent"
                            BorderThickness="0" />
                        <Button
                            x:Name="CloseButton"
                            Click="CloseButton_Click"
                            FontSize="11"
                            Padding="4,1"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="&#10005;" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#8595;" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="DownloadLabelText" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                        <TextBlock x:Name="DownloadValueText" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#8593;" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource SuccessFillColorDefaultBrush}" />
                        <TextBlock x:Name="UploadLabelText" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                        <TextBlock x:Name="UploadValueText" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource SuccessFillColorDefaultBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#8693;" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="TotalLabelText" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                        <TextBlock x:Name="TotalValueText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
